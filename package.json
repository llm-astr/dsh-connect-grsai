{
  "name": "dsh-grsai-video",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "GrsAI Minimax H3 and Agnes Video 2.5 async video tools for DSH",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "video-core.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": { "test": "node --test test-core.js test-client.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"] }
  }
}
